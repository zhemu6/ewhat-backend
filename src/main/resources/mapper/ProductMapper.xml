<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lushihao.ewhatbackend.mapper.ProductMapper">

    <resultMap id="BaseResultMap" type="com.lushihao.ewhatbackend.model.entity.Product">
            <id property="id" column="id" />
            <result property="name" column="name" />
            <result property="schoolId" column="school_id" />
            <result property="images" column="images" />
            <result property="description" column="description" />
            <result property="payPoints" column="pay_points" />
            <result property="actualPoints" column="actual_points" />
            <result property="type" column="type" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,name,school_id,images,description,pay_points,
        actual_points,type,status,create_time,update_time
    </sql>
    <select id="queryProductOfSchool" resultType="com.lushihao.ewhatbackend.model.entity.Product" parameterType="java.lang.Long">
        SELECT p.`id`,
               p.`school_id`,
               p.`name`,
               p.`images`,
               p.`description`,
               p.`pay_points`,
               p.`actual_points`,
               p.`type`,
               p.`status`,
               sp.`stock`,
               sp.begin_time,
               sp.end_time
        FROM tb_product p
                 LEFT JOIN tb_seckill_product sp ON p.id = sp.product_id
        WHERE p.school_id = #{schoolId}
          AND p.status = 1
    </select>
</mapper>
